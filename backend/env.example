# IntelliCPP Backend Environment Configuration
# Copy this file to backend/.env

PORT=3001
NODE_ENV=development

# Path to your IntelliCPP project root (where data/ folder is)
# Leave empty to auto-detect (default: one level above backend/)
WORKSPACE_ROOT=

# CORS Allowed Origins (comma-separated for multiple origins)
# Defaults to localhost:3000, localhost:3001 in development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Execution Sandboxing Configuration
# Set USE_DOCKER_SANDBOX=true to run code in isolated Docker/Podman container
USE_DOCKER_SANDBOX=false
DOCKER_SANDBOX_IMAGE=ubuntu:22.04

# Rate Limiting & Concurrency Settings
# Token Bucket capacity (burst allowance)
TOKEN_BUCKET_RUN_CAPACITY=5
# Token refill rate per second (0.166 = 1 token every 6 seconds => 10 runs/min sustained)
TOKEN_BUCKET_RUN_REFILL_PER_SEC=0.166
# Max simultaneous executions per IP
MAX_CONCURRENT_RUNS_PER_IP=2

# Suggestions / Autocomplete Rate Limit (requests per minute)
RATE_LIMIT_SUGGESTIONS_PER_MIN=120
