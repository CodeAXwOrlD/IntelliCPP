# ═══════════════════════════════════════════════════════════════════════
# INTELLICPP - SECURITY & BUILD IGNORE RULES (.gitignore)
# ═══════════════════════════════════════════════════════════════════════

# 1. Environment Variables & Secret Credentials (CRITICAL SECURITY)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
*.crt
credentials.json
token.json
secret.json
secrets.json
auth.json
*.id_rsa
*.id_ed25519

# 2. Dependencies & Package Managers
node_modules/
jspm_packages/
bower_components/
.pnp
.pnp.js

# 3. Build Outputs, Binaries & Compiled Objects
build/
dist/
out/
bin/
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.out
*.a
*.lib
*.node
test_backend
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.s
*.asm

# 4. Framework & Cloud Deployments
.vercel
.cache/
.parcel-cache/
.eslintcache
.next/
.nuxt/

# 5. Logs & Debug Records
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Test & Coverage Reports
coverage/
.nyc_output/
*.lcov

# 7. OS & System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 8. Editor & IDE Settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak

# 9. Sandboxes & Temporary Run Files
/tmp/intellicpp*
/tmp/codeflow*
*.tmp
*.temp
