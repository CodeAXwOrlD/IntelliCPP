{
  "name": "intellicpp",
  "version": "2.0.0",
  "description": "IntelliCPP frontend and backend orchestration",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm start",
    "dev:server": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "install-deps": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
